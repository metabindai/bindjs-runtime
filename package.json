{
  "name": "@metabindai/bindjs",
  "version": "0.0.0",
  "private": true,
  "description": "BindJS runtime + React renderer packages",
  "type": "module",
  "packageManager": "pnpm@10.13.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:fixtures": "pnpm --filter @metabindai/bindjs-runtime exec vitest run tests/fixtures",
    "fixtures:accept": "pnpm --filter @metabindai/bindjs-runtime exec vitest run tests/fixtures -u",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
