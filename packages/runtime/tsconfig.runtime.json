{
    "compilerOptions": {
        "allowJs": true,
        "outDir": "./dist-runtime",
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleDetection": "force",
    },
    "include": [
        "./src/runtime"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "**/*.spec.ts",
        "./src/runtime/BindJSRuntime.test.js"
    ]
}